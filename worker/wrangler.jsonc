{
  "name": "bottlesense-api",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  // keep GAS_URL / DEV_MODE and other variables you set in the dashboard
  "keep_vars": true,
  // Anthropic API rejects requests that egress from some Asian data centers (403 "Request not allowed").
  // Run the Worker next to the API in the US so every user, wherever they are, reaches it from a supported region.
  "placement": { "region": "aws:us-east-1" },
  "kv_namespaces": [
    { "binding": "CELLAR_KV", "id": "2156c87518404b7d9bda22982f2ad518" }
  ],
  // atomic quota / rate-limit / OTP counters (SQLite-backed Durable Objects, work on the Workers Free plan)
  "durable_objects": {
    "bindings": [
      { "name": "LIMITER", "class_name": "Limiter" },
      // one per sync key: serialises cellar merges so two devices syncing at once never overwrite each other
      { "name": "USER_SYNC", "class_name": "UserSync" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Limiter"] },
    { "tag": "v2", "new_sqlite_classes": ["UserSync"] }
  ]
}
